--model-path   ../grsolver/mesa-profiles/aag21.mesa.prof
--model-name    aag21
--model-type    MESA

--wma-vel
--wma-n         100
--wma-exp       3
--factor-interp 10

--adm-problem   StellarTable
--eos-path      ../grsolver/SFHo.h5
--eos-type      StellarCollapse

--use-rhocut
--rhocut        2.0e3
--zones         1000
--interp-method linear

--save-path     test-profiles